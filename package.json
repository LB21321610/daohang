{
  "name": "personal-navigation",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "content:build": "tsx scripts/build-content.mts",
    "content:import-carrot": "tsx scripts/import-carrot.mts",
    "links:check": "tsx scripts/check-links.mts",
    "dev": "npm run content:build && vite",
    "build": "npm run content:build && tsc --noEmit && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "audit:high": "npm audit --audit-level=high",
    "test": "npm run content:build && vitest run",
    "test:e2e": "npm run build && npm run test:sites && playwright test",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "check": "npm run audit:high && npm run content:build && npm run typecheck && npm run lint && npm run test && npm run build && npm run test:sites && playwright test"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "10.10.0",
    "jsdom": "30.0.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "6.4.3",
    "vitest": "5.0.0"
  }
}
